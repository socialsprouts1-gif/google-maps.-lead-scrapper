{
    "manifest_version": 3,
    "name": "Google Maps Easy Scrape",
    "version": "1.1",
    "description": "Google Maps Easy Scrape by Mike Powers",
    "permissions": ["activeTab", "scripting", "storage"],
    "optional_host_permissions": ["http://*/*", "https://*/*"],
    "action": {
      "default_popup": "popup.html"
    },
    "icons": {
      "16": "map.png",
      "48": "map.png",
      "128": "map.png"
    }
  }
  